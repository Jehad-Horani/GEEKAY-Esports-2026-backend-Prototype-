    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "firebase": "^12.12.1",
    "framer-motion": "^10.12.16",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.221.0",
    "multer": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.11.2",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
