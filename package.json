    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "esbuild": "^0.28.1",
    "eslint": "^10.2.1",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0.2",
